{
  "manifest_version": 3,
  "name": "Claude File Manager — Browser Control",
  "version": "1.0.0",
  "description": "Lets Claude File Manager MCP control this browser (navigate, click, type, evaluate, screenshot). Connects to a local relay started by the MCP server.",
  "permissions": [
    "tabs",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
