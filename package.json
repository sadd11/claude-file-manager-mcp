{
  "name": "claude-file-manager-mcp",
  "version": "1.5.1",
  "description": "MCP server for creating, reading, editing and deleting files and folders, with an optional terminal tool",
  "type": "module",
  "bin": {
    "claude-file-manager-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
